{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vic-schedule-studio",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 도메인은 Cloudflare Registrar에서 산 victory-broadcast.com. workers.dev 주소는 이전 검증용으로 남긴다.
  "routes": [{ "pattern": "victory-broadcast.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "vic-schedule-studio" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "vic-schedule-studio-cache" }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "vic-schedule-studio-tags",
      "database_id": "2645f0a0-c497-4588-bae1-c374f6b30709"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // 방송 감지 1분(2026-11-13 소유자): GitHub Actions 5분(실측 수 시간 간격)·매일 1회를 이 하나로 합쳤다.
  // 매시 7분 = 연간 인사이트 아카이브·원본 통계 정리(0160). 할 일 없으면 조회 몇 번으로 끝난다.
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },
  // 유료 Workers 요청당 CPU 한도. 기본 30초면 충분하지만 폭주 시 비용 상한으로 둔다.
  "limits": { "cpu_ms": 30000 },
  // 한국 요청이 미국 데이터센터(EWR·LAX)로 가서, Supabase(AWS 서울) 옆에서 실행한다. supabase.co 주소는 Cloudflare 프록시라
  // hostname 지정은 "local"로 판정돼 효과가 없었다(2026-11-13) → 지역을 직접 지정.
  "placement": { "mode": "targeted", "region": "aws:ap-northeast-2" },
  "vars": { "NEXT_PUBLIC_SITE_URL": "https://victory-broadcast.com" },
  "observability": { "enabled": true }
}

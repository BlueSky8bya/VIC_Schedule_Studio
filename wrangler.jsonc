{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vic-schedule-studio",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 도메인은 Cloudflare Registrar에서 산 victory-broadcast.com. workers.dev 주소는 이전 검증용으로 남긴다.
  "routes": [{ "pattern": "victory-broadcast.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "vic-schedule-studio" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "vic-schedule-studio-cache" }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "vic-schedule-studio-tags",
      "database_id": "2645f0a0-c497-4588-bae1-c374f6b30709"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // 예전 vercel.json cron과 같은 시각(UTC 18:00 = KST 03:00).
  "triggers": { "crons": ["0 18 * * *"] },
  // 유료 Workers 요청당 CPU 한도. 기본 30초면 충분하지만 폭주 시 비용 상한으로 둔다.
  "limits": { "cpu_ms": 30000 },
  // 한국 요청이 미국 데이터센터(EWR)로 가는 경우가 있어, 매 요청 여러 번 부르는 Supabase DB 옆에서 실행한다.
  "placement": { "mode": "targeted", "hostname": "hmktfffdyhtybnpspdnu.supabase.co" },
  "vars": { "NEXT_PUBLIC_SITE_URL": "https://victory-broadcast.com" },
  "observability": { "enabled": true }
}

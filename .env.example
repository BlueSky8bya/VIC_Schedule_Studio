# VIC Schedule Studio — 환경 변수 템플릿
# 로컬: 이 파일을 .env.local로 복사해 채운다. (.env.local은 git에 올라가지 않음)
# 프로덕션(Cloudflare Workers): 비밀값은 Worker Secrets(scripts/cloudflare/push-secrets.mjs),
# NEXT_PUBLIC_* 은 Workers Builds 빌드 변수, NEXT_PUBLIC_SITE_URL은 wrangler.jsonc vars에 둔다.
# NEXT_PUBLIC_ 접두사 변수는 브라우저에 노출된다(공개 가능 값만). 나머지는 서버 전용 비밀.

# ── Supabase (필수) ───────────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 확인.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# service_role 키 — 절대 클라이언트에 노출 금지(서버 전용). 개발자/소유자 판별, 신뢰 멤버 조회에 사용.
SUPABASE_SERVICE_ROLE_KEY=<service role secret key>

# ── 사이트 URL (프로덕션 필수) ────────────────────────────────────
# 배포된 정식 도메인. Google OAuth 리다이렉트와 Supabase 허용목록이 이 값과 일치해야 한다.
# 예: https://victory-broadcast.com  (비워두면 http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://your-domain

# ── 소유자(스트리머) (필수) ──────────────────────────────────────
# 이 구글 이메일로 로그인하면 owner(전체 편집권). 배포 시 빅토리님 구글 이메일로 설정.
OWNER_EMAIL=victory-google-email@example.com

# ── 편집실 비밀번호 페퍼 (필수) ──────────────────────────────────
# 최초공개 게이트 비밀번호 해시에 섞는 비밀값(scrypt pepper).
# 길고 무작위한 값으로 한 번 정하면 바꾸지 말 것 — 바꾸면 기존 비밀번호가 무효화된다.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_LAYER_UNLOCK_SECRET=<32바이트 이상 무작위 hex>

# ── 예약 작업 인증 (프로덕션 필수) ───────────────────────────────
# /api/cron/* 를 부르는 Bearer 토큰. Worker Secret과 GitHub Actions secret에 같은 값.
CRON_SECRET=<32바이트 이상 무작위 hex>

# ── 선택 ─────────────────────────────────────────────────────────
# 방문 계정 해시 소금(없으면 SUPABASE_SERVICE_ROLE_KEY 사용).
VISIT_HASH_SALT=
# SOOP 방송국 아이디(기본 toryvac).
SOOP_BJ_ID=
# 개인정보 보존기한 정리 크론 켜기("1"일 때만).
PRIVACY_RETENTION_CLEANUP_ENABLED=

# ── DB 마이그레이션 스크립트 전용 (런타임 아님) ──────────────────
# scripts/apply-db.mjs / verify-db.mjs 가 직접 DB 접속할 때만 사용. Worker에는 넣지 않는다.
# Supabase 대시보드 → Project Settings → Database → Connection 의 비밀번호.
SUPABASE_DB_PASSWORD=<database password>

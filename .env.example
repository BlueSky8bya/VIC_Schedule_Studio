# VIC Schedule Studio — 환경 변수 템플릿
# 로컬: 이 파일을 .env.local로 복사해 채운다. (.env.local은 git에 올라가지 않음)
# 프로덕션(Vercel): 아래 값들을 Vercel 프로젝트 Settings → Environment Variables에 등록한다.
# NEXT_PUBLIC_ 접두사 변수는 브라우저에 노출된다(공개 가능 값만). 나머지는 서버 전용 비밀.

# ── Supabase (필수) ───────────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 확인.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# service_role 키 — 절대 클라이언트에 노출 금지(서버 전용). 개발자/소유자 판별, 신뢰 멤버 조회에 사용.
SUPABASE_SERVICE_ROLE_KEY=<service role secret key>

# ── 사이트 URL (프로덕션 필수) ────────────────────────────────────
# 배포된 정식 도메인. Google OAuth 리다이렉트와 Supabase 허용목록이 이 값과 일치해야 한다.
# 예: https://vic-schedule-studio.vercel.app  또는  https://schedule.victory.example
# (비워두면 Vercel 프로덕션 도메인으로 자동 폴백되지만, 명시 권장)
NEXT_PUBLIC_SITE_URL=https://your-domain

# ── 소유자(스트리머) (필수) ──────────────────────────────────────
# 이 구글 이메일로 로그인하면 owner(전체 편집권). 배포 시 빅토리님 구글 이메일로 설정.
OWNER_EMAIL=victory-google-email@example.com

# ── 비공개 레이어 비밀번호 페퍼 (필수) ───────────────────────────
# 비공개 레이어 잠금해제 비밀번호 해시에 섞는 비밀값(scrypt pepper).
# 길고 무작위한 값으로 한 번 정하면 바꾸지 말 것 — 바꾸면 기존 비밀번호가 무효화된다.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_LAYER_UNLOCK_SECRET=<32바이트 이상 무작위 hex>

# ── 비공개 일정 본문 at-rest 암호화 키 (필수) ────────────────────
# 비공개(엠바고/작업자/나만) 일정의 제목·설명을 DB에 암호화(AES-256-GCM)해 저장하는 키.
# raw DB 접근(Supabase 대시보드·덤프·백업 유출)으로는 암호문만 보이게 한다. 서버만 복호화.
# ⚠ 이 키를 잃으면 기존 비공개 본문을 복구할 수 없다 — 안전한 곳에 백업할 것(운영자 에스크로우).
#   passcode와는 무관하다(비밀번호를 잃어도 본문은 이 키로 살아있음).
# 생성: openssl rand -base64 32   (또는)   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PRIVATE_DATA_ENC_KEY=<base64로 인코딩된 32바이트 키>

# ── Supabase Storage (스티커 이미지 업로드용) ────────────────────
SUPABASE_STORAGE_BUCKET=vic-schedule-assets

# ── DB 마이그레이션 스크립트 전용 (런타임 아님) ──────────────────
# scripts/apply-db.mjs / verify-db.mjs 가 직접 DB 접속할 때만 사용. Vercel에는 넣지 않아도 됨.
# Supabase 대시보드 → Project Settings → Database → Connection 의 비밀번호.
SUPABASE_DB_PASSWORD=<database password>
